{
  "name": "@epaper-studio/ui",
  "version": "0.1.0",
  "description": "Shared UI tokens, preview controls, and design system primitives for E-Paper Studio",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
