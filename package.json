{
  "name": "epaper-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Scalable, multilingual e-paper publishing and document studio",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "pnpm --filter @epaper-studio/web dev",
    "build": "pnpm -r run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "epaper:baseline": "vitest run --config scripts/vitest.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "pnpm -r exec rm -rf dist node_modules"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.50.1",
    "@types/node": "^22.13.4",
    "eslint": "^9.20.0",
    "prettier": "^3.5.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.5"
  }
}
