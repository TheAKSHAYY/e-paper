# ==========================================
# E-Paper Studio Environment Configuration
# ==========================================
# Copy this file to .env or .env.local for local development.
# Do NOT commit secrets or real credentials to version control.

# Node Environment
NODE_ENV=development
PORT=3000

# ------------------------------------------
# Web Application (apps/web)
# ------------------------------------------
VITE_APP_TITLE=E-Paper Studio
VITE_APP_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3000

# ------------------------------------------
# Supabase Configuration
# ------------------------------------------
# Local development defaults or hosted project credentials
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder

# Server-only / Service role key (used by worker/renderer only, NEVER in web client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ------------------------------------------
# PDF & E-Paper Rendering Worker (apps/renderer)
# ------------------------------------------
PORT=4000
RENDER_CONCURRENCY=4
RENDER_TIMEOUT_MS=35000
MAX_PAYLOAD_MB=15
RATE_LIMIT_MAX_PER_MINUTE=60
ALLOWED_ORIGINS=http://localhost:5173,https://your-app.pages.dev
ALLOWED_ASSET_ORIGINS=
RENDER_API_KEY=
# Path to Chromium executable in container (default in Docker: /usr/bin/chromium)
CHROMIUM_PATH=/usr/bin/chromium

# ------------------------------------------
# Storage (S3 / Supabase Storage Bucket)
# ------------------------------------------
STORAGE_BUCKET_DOCUMENTS=epaper-documents
STORAGE_BUCKET_RENDERED_PDF=epaper-rendered-pdf
STORAGE_BUCKET_FONTS=epaper-fonts

# ------------------------------------------
# Subscriptions & Billing (Stripe / LemonSqueezy)
# ------------------------------------------
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_PRO_PRICE_ID=price_placeholder

# ------------------------------------------
# Multilingual & Typography CDN
# ------------------------------------------
FONTS_CDN_URL=https://fonts.epaper-studio.internal
