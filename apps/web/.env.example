# E-Paper Studio Web - Environment Configuration Example
# Copy this file to apps/web/.env.local or configure in your deployment dashboard (e.g. Vercel)

# Base URL of the dedicated Playwright PDF renderer service (e.g. Render.com)
# Development: http://localhost:4000
# Production: https://your-renderer-service.onrender.com
# NOTE: Required in static production deployments (Vercel/Cloudflare Pages)
VITE_RENDERER_URL=http://localhost:4000

# Optional API key matching RENDER_API_KEY on the renderer backend (leave blank if not using key auth)
# SECURITY NOTE: All VITE_* variables are embedded directly into client JavaScript bundles.
# Do NOT store private administrative secrets or service_role keys here.
VITE_RENDERER_API_KEY=

