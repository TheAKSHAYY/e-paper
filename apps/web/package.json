{
  "name": "@epaper-studio/web",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive web studio for composing and previewing e-paper publications",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm --filter \"@epaper-studio/web^...\" build && node scripts/copy-fonts.js && tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@epaper-studio/document-schema": "workspace:*",
    "@epaper-studio/template-engine": "workspace:*",
    "@epaper-studio/typography": "workspace:*",
    "@epaper-studio/ui": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@epaper-studio/renderer": "workspace:*",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
